# Segredos da FieldOps API.
#
# Copie para `.env` e preencha. O `.env` é ignorado pelo git e nunca deve ser
# versionado. A aplicação NÃO sobe com estas variáveis ausentes — falhar na
# partida é melhor do que rodar com um segredo previsível.

# Chave de assinatura dos JWT. HS512 exige no mínimo 64 caracteres.
# Gere uma nova, exclusiva por ambiente:
#   openssl rand -base64 64 | tr -d '\n'
FIELDOPS_JWT_SECRET=

# Senha compartilhada pelos usuários de desenvolvimento criados pelo seed.
# Sem ela o seed não roda (e nenhum admin com senha conhecida é criado).
FIELDOPS_SEED_PASSWORD=

# Senha do Postgres. Usada tanto pelo docker compose (ao criar o banco)
# quanto pela aplicação (ao conectar) — as duas leem esta mesma variável.
FIELDOPS_DB_PASSWORD=

# URL e usuário do banco. Em docker-compose.prod.yml, a URL é sobrescrita
# para usar o serviço `postgres`; localmente, mantenha localhost:5433.
FIELDOPS_DB_URL=jdbc:postgresql://localhost:5433/fieldops
FIELDOPS_DB_USER=fieldops

# Perfil Spring. O script local usa `dev`; produção deve usar `prod`.
SPRING_PROFILES_ACTIVE=dev

# Storage e recuperação de senha. Para uma demonstração sem SES, use noop.
FIELDOPS_STORAGE_MODE=local
FIELDOPS_STORAGE_BUCKET=
FIELDOPS_MAIL_PROVIDER=noop
FIELDOPS_MAIL_FROM=
FIELDOPS_PASSWORD_RESET_URL=http://localhost:4200/reset-password
AWS_REGION=us-east-1

# Origens web autorizadas para CORS, separadas por vírgula.
# React Native nativo não envia Origin; estes valores cobrem o painel e o Expo Web.
FIELDOPS_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
