# Segredos da FieldOps API.
#
# Copie para `.env` e preencha. O `.env` é ignorado pelo git e nunca deve ser
# versionado. A aplicação NÃO sobe com estas variáveis ausentes — falhar na
# partida é melhor do que rodar com um segredo previsível.

# Chave de assinatura dos JWT. HS512 exige no mínimo 64 caracteres.
# Gere uma nova, exclusiva por ambiente:
#   openssl rand -base64 64 | tr -d '\n'
FIELDOPS_JWT_SECRET=

# Senha compartilhada pelos usuários de desenvolvimento criados pelo seed.
# Sem ela o seed não roda (e nenhum admin com senha conhecida é criado).
FIELDOPS_SEED_PASSWORD=

# Senha do Postgres. Usada tanto pelo docker compose (ao criar o banco)
# quanto pela aplicação (ao conectar) — as duas leem esta mesma variável.
FIELDOPS_DB_PASSWORD=
